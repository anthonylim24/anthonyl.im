{
  "name": "anthonyl.im",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run index.ts",
    "dev": "pushd frontend && bun run build && popd && bun --watch index.ts",
    "codex:setup": "bash .codex/setup.sh",
    "codex:maintenance": "bash .codex/maintenance.sh",
    "codex:dev": "bash .codex/dev.sh",
    "codex:check": "bash .codex/check.sh",
    "codex:test": "bash .codex/cloud-setup.test.sh",
    "claude:setup": "bash .claude/cloud/setup.sh",
    "claude:verify": "bash .claude/cloud/verify.sh",
    "claude:dev": "bash .claude/cloud/dev.sh",
    "claude:e2e": "bash .claude/cloud/e2e.sh",
    "claude:test": "bash .claude/cloud/cloud-setup.test.sh",
    "test": "bun test --bail",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "test:int": "INTEGRATION=1 bun test --bail",
    "test:eval": "bun run server/src/igPlaces/eval/run.ts",
    "preview:wait": "bun scripts/wait-for-preview.ts",
    "preview:stamp": "bun server/src/previewStamp.ts",
    "agent:login": "bun scripts/clerk-agent-login.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@clerk/backend": "^3.32.0",
    "@hono/zod-validator": "^0.9.1",
    "groq-sdk": "^1.6.0",
    "hono": "^4.13.21",
    "zod": "^4.6.7"
  }
}
