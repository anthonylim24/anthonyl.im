  "peerDependencies": {
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.6",
    "groq-sdk": "^1.5.0",
    "hono": "^4.13.2",
    "openai": "^7.4.0",
    "zod": "^4.4.3"
  }
