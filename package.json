    "claude:dev": "bash .claude/cloud/dev.sh",
    "claude:e2e": "bash .claude/cloud/e2e.sh",
    "claude:test": "bash .claude/cloud/cloud-setup.test.sh",
    "test": "bun test --bail",
    "test:int": "INTEGRATION=1 bun test --bail",
    "test:eval": "bun run server/src/igPlaces/eval/run.ts",
    "preview:wait": "bun scripts/wait-for-preview.ts",
